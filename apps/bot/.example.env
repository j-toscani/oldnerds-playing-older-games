# --- Bot Service ---

# Port auf dem der Bot-Server läuft
PORT=4000

# Discord Interactions Endpoint — Signatur-Verifikation
DISCORD_APP_KEY=your_discord_public_key_hex

# URL der Website (für Gameday-Links)
APP_URL=https://onog.j-toscani.com

# API URL (used by /match)
API_URL=http://localhost:4001

# Shared secret for /api/bot/* (min. 32 characters, same value as in apps/api)
BOT_API_SECRET=change-me-to-a-random-string-of-32-chars

# --- Nur für register-commands Script ---

# Discord Bot Token (zum Registrieren von Slash-Commands)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Discord Application ID
DISCORD_APP_ID=your_discord_app_id

# Optional: Guild-ID für schnelleres Testen (ohne = Global-Command, bis 1h Delay)
# DISCORD_GUILD_ID=your_guild_id
