# --- API Service ---

# Port auf dem der API-Server läuft
PORT=4001

# SurrealDB Verbindung
SURREAL_URL=ws://localhost:8000
SURREAL_NAMESPACE=onog
SURREAL_DATABASE=onog
SURREAL_USER=root
SURREAL_PASS=root

# Shared secret the bot sends as `X-Bot-Secret` for /api/bot/* (min. 32 characters, same value in apps/bot)
BOT_API_SECRET=change-me-to-a-random-string-of-32-chars
